# Отримайте на https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
# Створіть один раз через: npm run session
TG_SESSION=

# Токен від @BotFather та ваш числовий chat_id
BOT_TOKEN=
BOT_CHAT_ID=

DATABASE_PATH=./data/realty.sqlite
LOG_LEVEL=info

# Опитування сайтів rieltor.ua і real-estate.lviv.ua, хвилин (0 = вимкнено)
SITES_INTERVAL_MIN=15

# Аварійне відновлення: перевірка після старту та періодично (0 = вимкнути періодичну)
AUTO_RESCAN_DAYS=2
RESCAN_INTERVAL_HOURS=6
