{
  "name": "realty-monitoring",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "session": "tsx src/create-session.ts",
    "session:qr": "tsx src/create-session-qr.ts",
    "chat-id": "tsx src/get-chat-id.ts",
    "backfill": "tsx src/backfill.ts",
    "streets:build": "tsx scripts/build-streets.ts",
    "streets:try": "tsx scripts/try-streets.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:coverage": "node --experimental-test-coverage --test-coverage-lines=98 --test-coverage-branches=90 --test-coverage-functions=90 --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "cheerio": "^1.1.2",
    "dotenv": "18.0.9",
    "pino": "10.4.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "0.12.0",
    "teleproto": "1.232.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/qrcode-terminal": "0.12.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
